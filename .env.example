# Buildicy ERP — environment variables
# Copy this file to `.env` (which is gitignored) and fill in real values.
#
# After Phase 0, the Firebase web API key below should be the ROTATED one
# (re-issued from Firebase Console after the previous key was leaked via
# the seed script). HTTP referrer restrictions are configured at the
# Google Cloud Credentials page, NOT here.

# ---------- Firebase Web SDK (browser SPA) ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---------- Feature flags (Phase 0+) ----------
# VITE_USE_FIREBASE_AUTH: Phase 1+. When false, the SPA falls back to the
#   localStorage persona switcher (dev-only convenience). Flip to 'true'
#   once real Auth users are seeded.
VITE_USE_FIREBASE_AUTH=false

# VITE_USE_FIRESTORE_DATA: Phase 2+. When true, the SPA reads collections
#   from Firestore via onSnapshot; LS becomes an offline cache only.
VITE_USE_FIRESTORE_DATA=false

# VITE_USE_CF_WRITES: Phase 5+. When true, mutations go through callable
#   Cloud Functions instead of direct Firestore writes.
VITE_USE_CF_WRITES=false

# VITE_USE_APP_CHECK: Phase 9. When true, the SPA requires a valid
#   reCAPTCHA v3 App Check token for every backend call.
VITE_USE_APP_CHECK=false
VITE_RECAPTCHA_SITE_KEY=

# ---------- Backend (deprecated) ----------
# VITE_BACKEND_API_URL was used by the legacy Express server (server/index.js)
# which was removed in Phase 6. The SPA now talks directly to Firebase + Cloud
# Functions; no backend URL is needed.