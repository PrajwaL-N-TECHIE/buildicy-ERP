rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    // Checks if the request comes from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Safely reads the user document for the current user
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Gets the user's role tier (checks token claims first, falls back to document)
    function roleTier() {
      return request.auth.token.roleTier != null
        ? request.auth.token.roleTier
        : (getUserData() != null ? getUserData().roleTier : 'contributor');
    }

    function isAdmin() {
      return isAuthenticated() && (roleTier() == 'admin' || request.auth.token.roleTier == 'admin');
    }

    function isReviewer() {
      return isAuthenticated() && (roleTier() == 'reviewer' || request.auth.token.roleTier == 'reviewer');
    }

    function isContributor() {
      return isAuthenticated() && (roleTier() == 'contributor' || request.auth.token.roleTier == 'contributor');
    }

    // ============================================================
    // COLLECTION RULES
    // ============================================================

    // 1. USERS COLLECTION
    // Profile documents (name, email, roleTier, title, salary, etc.)
    match /users/{userId} {
      // All authenticated workspace users can view user profiles
      allow read: if isAuthenticated();
      
      // Admins can manage any user doc; users can update their own profile details
      allow create, update: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // 2. PROJECTS COLLECTION
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isReviewer());
    }

    // 3. TASKS COLLECTION
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      // Contributors can submit/update assigned tasks; Reviewers & Admins can sign-off/edit
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin() || isReviewer();
    }

    // 4. MEETINGS COLLECTION
    match /meetings/{meetingId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin() || isReviewer();
    }

    // 5. ATTENDANCE & CHECK-INS
    match /attendance/{document=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 6. CHAT MESSAGES & CHANNELS
    match /chat/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /chat_messages/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // 7. SYSTEM AUDIT LOGS
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Catch-all: allow authenticated workspace users access to all ERP resources
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}